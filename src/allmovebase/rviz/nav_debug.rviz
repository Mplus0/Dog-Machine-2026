Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Map
      Enabled: true
      Name: Map
      Topic: /map
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
      Value: true
    - Class: rviz/LaserScan
      Enabled: true
      Name: LaserScan
      Topic: /scan
      Color Transformer: Intensity
      Queue Size: 10
      Size (Pixels): 3
      Style: Flat Squares
      Use Fixed Frame: true
      Value: true
    - Class: rviz/PoseArray
      Enabled: true
      Name: AMCLParticles
      Topic: /particlecloud
      Color: 255; 25; 0
      Shaft Length: 0.08
      Shaft Radius: 0.01
      Head Length: 0.04
      Head Radius: 0.02
      Value: true
    - Class: rviz/PoseWithCovariance
      Enabled: true
      Name: AMCLPose
      Topic: /amcl_pose
      Color: 255; 255; 0
      Position Transformer: XYZ
      Value: true
    - Class: rviz/Odometry
      Enabled: true
      Name: EKFOdom
      Topic: /odometry/filtered
      Shape: Arrow
      Keep: 60
      Color: 0; 180; 255
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: GlobalPlan_Navfn
      Topic: /move_base/NavfnROS/plan
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Buffer Length: 1
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: LocalPlan_TEB
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Color: 255; 80; 0
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
      Value: true
    - Class: rviz/Map
      Enabled: true
      Name: GlobalCostmap
      Topic: /move_base/global_costmap/costmap
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Value: true
    - Class: rviz/Map
      Enabled: true
      Name: LocalCostmap
      Topic: /move_base/local_costmap/costmap
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Topic: /clicked_point
      Single click: true
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 7.5
      Pitch: 1.1
      Yaw: 3.1
      Focal Point:
        X: 5.5
        Y: 0.75
        Z: 0.2
Window Geometry:
  Height: 960
  Width: 1600
