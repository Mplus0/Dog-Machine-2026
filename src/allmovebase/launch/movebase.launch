

<launch>
  <arg name="scan_topic" default="/scan"/>
  <!--
    In ground-filter mode the filtered scan marks obstacles, while the dedicated
    ground-aware scan supplies finite, sensor-bounded clearing rays. Keeping this
    switch false preserves the legacy single-/scan configuration.
  -->
  <arg name="use_separate_clearing_scan" default="false"/>
  <arg name="clearing_scan_topic" default="/scan_ground_clearing"/>
  <arg name="costmap_inflation_radius" default="0.4"/>
  <arg name="costmap_cost_scaling_factor" default="7.0"/>
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" >
   <param name="base_global_planner" value="navfn/NavfnROS"/>
   <rosparam file="$(find allmovebase)/config/navfn_planner_params.yaml" command="load"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <rosparam file="$(find allmovebase)/config/teb_local_planner_params.yaml" command="load" />
    
    <rosparam file="$(find allmovebase)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find allmovebase)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find allmovebase)/config/common_costmap_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find allmovebase)/config/common_costmap_params.yaml" command="load" ns="local_costmap" />

    <!-- Launch-time overrides allow conservative inflation A/B tests without
         changing the shared costmap defaults for every navigation entrypoint. -->
    <param name="global_costmap/inflation_layer/inflation_radius"
           value="$(arg costmap_inflation_radius)"/>
    <param name="local_costmap/inflation_layer/inflation_radius"
           value="$(arg costmap_inflation_radius)"/>
    <param name="global_costmap/inflation_layer/cost_scaling_factor"
           value="$(arg costmap_cost_scaling_factor)"/>
    <param name="local_costmap/inflation_layer/cost_scaling_factor"
           value="$(arg costmap_cost_scaling_factor)"/>

    <!-- Explicit topics keep marking and clearing inputs independent. -->
    <param name="global_costmap/obstacle_layer/laser_scan_sensor/topic" value="$(arg scan_topic)"/>
    <param name="local_costmap/obstacle_layer/laser_scan_sensor/topic" value="$(arg scan_topic)"/>

    <!-- Legacy mode: the selected scan performs both marking and clearing. -->
    <param unless="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/observation_sources" value="laser_scan_sensor"/>
    <param unless="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/observation_sources" value="laser_scan_sensor"/>
    <param unless="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/laser_scan_sensor/clearing" value="true"/>
    <param unless="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/laser_scan_sensor/clearing" value="true"/>

    <!-- Ground-filter mode: filtered endpoints mark; ground-aware finite rays only clear. -->
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/observation_sources"
           value="laser_scan_sensor ground_clearing_sensor"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/observation_sources"
           value="laser_scan_sensor ground_clearing_sensor"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/laser_scan_sensor/clearing" value="false"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/laser_scan_sensor/clearing" value="false"/>

    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/ground_clearing_sensor/topic"
           value="$(arg clearing_scan_topic)"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/ground_clearing_sensor/data_type"
           value="LaserScan"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/ground_clearing_sensor/marking" value="false"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/ground_clearing_sensor/clearing" value="true"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/ground_clearing_sensor/inf_is_valid" value="false"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/ground_clearing_sensor/obstacle_range" value="3.0"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="global_costmap/obstacle_layer/ground_clearing_sensor/raytrace_range" value="3.0"/>

    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/ground_clearing_sensor/topic"
           value="$(arg clearing_scan_topic)"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/ground_clearing_sensor/data_type"
           value="LaserScan"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/ground_clearing_sensor/marking" value="false"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/ground_clearing_sensor/clearing" value="true"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/ground_clearing_sensor/inf_is_valid" value="false"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/ground_clearing_sensor/obstacle_range" value="3.0"/>
    <param if="$(arg use_separate_clearing_scan)"
           name="local_costmap/obstacle_layer/ground_clearing_sensor/raytrace_range" value="3.0"/>

    <param name="global_costmap/robot_base_frame" value="base_link"/>
    <param name="global_costmap/global_frame" value="map"/>
    <param name="local_costmap/robot_base_frame" value="base_link"/>
    <param name="local_costmap/global_frame" value="odom"/>

    <rosparam file="$(find allmovebase)/config/recovery_behaviors_params.yaml" command="load" />

    <param name="planner_patience" value="5.0" />
    <param name="controller_patience" value="10.0" />
    <param name="controller_frequency" value="3.0"/> 
    <param name="transform_tolerance" value="0.55" />
    <param name="clearing_rotation_allowed" value="true" />
  </node>
</launch>
