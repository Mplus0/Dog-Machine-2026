

<launch>
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" >
   <param name="base_global_planner" value="navfn/NavfnROS"/>
   <rosparam file="$(find allmovebase)/config/navfn_planner_params.yaml" command="load"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <rosparam file="$(find allmovebase)/config/teb_local_planner_params.yaml" command="load" />
    
    <rosparam file="$(find allmovebase)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find allmovebase)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find allmovebase)/config/common_costmap_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find allmovebase)/config/common_costmap_params.yaml" command="load" ns="local_costmap" />

    <param name="global_costmap/robot_base_frame" value="base_link"/>
    <param name="global_costmap/global_frame" value="map"/>
    <param name="local_costmap/robot_base_frame" value="base_link"/>
    <param name="local_costmap/global_frame" value="odom"/>

    <rosparam file="$(find allmovebase)/config/recovery_behaviors_params.yaml" command="load" />

    <param name="planner_patience" value="5.0" />
    <param name="controller_patience" value="10.0" />
    <param name="controller_frequency" value="3.0"/> 
    <param name="transform_tolerance" value="0.55" />
    <param name="clearing_rotation_allowed" value="true" />
  </node>
</launch>
