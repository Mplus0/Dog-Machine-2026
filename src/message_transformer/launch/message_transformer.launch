<launch>
    <arg name="inspection_pitch_value" default="-6553"/>
    <arg name="navigation_pitch_value" default="0"/>
    <arg name="view_pose_step_sleep" default="0.5"/>
    <arg name="view_pose_pitch_repeat_count" default="3"/>
    <arg name="ros2qnx_debug" default="false"/>
    <arg name="ros2qnx_remote_ip" default="192.168.1.120"/>
    <arg name="ros2qnx_remote_port" default="43893"/>
    <arg name="ros2qnx_local_port" default="43894"/>
    <arg name="vel_x_factor" default="1.0"/>
    <arg name="vel_y_factor" default="1.0"/>
    <arg name="vel_yaw_factor" default="1.0"/>
    <arg name="standing_basic_states" default="6,9"/>
    <arg name="lie_basic_states" default="1"/>
    <arg name="spot_basic_states" default="6,9"/>
    <arg name="move_basic_states" default="6,9"/>
    <arg name="mode_switch_timeout" default="3.0"/>
    <arg name="mode_switch_retry_count" default="3"/>
    <arg name="stand_timeout" default="8.0"/>
    <arg name="stand_settle_sec" default="1.0"/>
    <arg name="command_gap" default="0.15"/>
    <arg name="default_prepare_gait" default="flat_low_gait"/>

    <node name="qnx2ros" pkg="message_transformer" type="qnx2ros" output="screen">
        <param name="server_port" value="43897" />   
        <param name="is_imu_pub" value="true" />
    </node>
    <node name="ros2qnx" pkg="message_transformer" type="ros2qnx" output="screen">
        <param name="vel_x_factor" value="$(arg vel_x_factor)" />
        <param name="vel_y_factor" value="$(arg vel_y_factor)" />
        <param name="vel_yaw_factor" value="$(arg vel_yaw_factor)" />
        <param name="local_port" value="$(arg ros2qnx_local_port)"/>
        <param name="remote_port" value="$(arg ros2qnx_remote_port)"/>
        <param name="remote_ip" value="$(arg ros2qnx_remote_ip)"/>
        <param name="isdebug" value="$(arg ros2qnx_debug)"/>
    </node>
    <node name="lite3_motion_cmd" pkg="message_transformer" type="lite3_motion_cmd.py" output="screen">
        <param name="command_topic" value="/lite3_motion_cmd"/>
        <param name="stand_timeout" value="$(arg stand_timeout)"/>
        <param name="stand_settle_sec" value="$(arg stand_settle_sec)"/>
        <param name="enter_move_mode_after_stand" value="false"/>
        <param name="robot_basic_state_topic" value="/lite3/robot_basic_state"/>
        <param name="robot_gait_state_topic" value="/lite3/robot_gait_state"/>
        <param name="robot_motion_state_topic" value="/lite3/robot_motion_state"/>
        <param name="robot_state_timeout" value="2.0"/>
        <param name="standing_basic_states" value="$(arg standing_basic_states)"/>
        <param name="lie_basic_states" value="$(arg lie_basic_states)"/>
        <param name="spot_basic_states" value="$(arg spot_basic_states)"/>
        <param name="move_basic_states" value="$(arg move_basic_states)"/>
        <param name="mode_switch_timeout" value="$(arg mode_switch_timeout)"/>
        <param name="mode_switch_retry_count" value="$(arg mode_switch_retry_count)"/>
        <param name="command_gap" value="$(arg command_gap)"/>
        <param name="default_prepare_gait" value="$(arg default_prepare_gait)"/>
        <param name="low_pose_height_value" value="-20000"/>
        <param name="normal_height_value" value="0"/>
        <param name="inspection_pitch_value" value="$(arg inspection_pitch_value)"/>
        <param name="navigation_pitch_value" value="$(arg navigation_pitch_value)"/>
        <param name="view_pose_step_sleep" value="$(arg view_pose_step_sleep)"/>
        <param name="view_pose_pitch_repeat_count" value="$(arg view_pose_pitch_repeat_count)"/>
    </node>
    <node name="nx2app" pkg="message_transformer" type="nx2app" output="screen" >
        <param name="server_port" value="43899" />
    </node>
    <node name="sensor_checker" pkg="message_transformer" type="sensor_checker" output="screen">
        <param name="imu_silent_limit" value="3"/>
        <param name="odom_silent_limit" value="3"/>
        <param name="odom2_silent_limit" value="3"/>
        <param name="joint_silent_limit" value="3"/>
        <param name="realsense_silent_time" value="3"/>
        <param name="lidar_silent_time" value="3"/>
        <param name="ultrasound_silent_time" value="3"/>
        <param name="check_freq_hz" value="5"/>
        <param name="isdebug" value="false"/>
    </node>
</launch>
